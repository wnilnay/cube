<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <!--元件的漸層-->

            <gradient
                android:startColor="@color/cube_green"
                android:centerColor="@color/cube_green"
                android:endColor="@color/cube_green"
                android:angle="270" />

            <!--邊框顏色、粗細-->
            <stroke
                android:width="1dp"
                android:color="#000" />

            <!--圓角-->
            <corners android:radius="12dp" />


        </shape>
    </item>
</selector>