<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    tools:context=".Cube3DFragment">
        <!-- 3D魔術方塊視圖 -->
    <com.example.test.RubiksCube3DView
        android:id="@+id/cube_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 調試信息顯示 -->
    <TextView
        android:id="@+id/debug_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="調試信息將在這裡顯示..."
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:padding="8dp"
        android:gravity="left"
        android:background="@android:color/black"
        android:maxLines="5"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <!-- 測試按鈕 -->
        <Button
            android:id="@+id/test_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="測試點擊檢測"
            android:textColor="@android:color/white"
            android:background="@drawable/gradient_button"
            android:padding="8dp"
            android:layout_margin="8dp" />

        <!-- 面檢測測試按鈕 -->
        <Button
            android:id="@+id/test_face_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="測試面檢測"
            android:textColor="@android:color/white"
            android:background="@drawable/gradient_button"
            android:padding="8dp"
            android:layout_margin="8dp" />

        <!-- 調試點控制按鈕 -->
        <Button
            android:id="@+id/debug_point_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="清除調試點"
            android:textColor="@android:color/white"
            android:background="@drawable/gradient_button"
            android:padding="8dp"
            android:layout_margin="8dp" />


    </LinearLayout>

    <!-- 重置按鈕 -->
    <Button
        android:id="@+id/reset_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="重置到初始狀態"
        android:textColor="@android:color/white"
        android:background="@drawable/gradient_button"
        android:padding="8dp"
        android:layout_margin="8dp" />


    <!-- 操作說明 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="拖動旋轉魔術方塊，點擊檢測格子位置"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:padding="16dp"
        android:gravity="center"
        android:background="@android:color/black" />

</LinearLayout> 