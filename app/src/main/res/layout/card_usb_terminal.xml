<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:backgroundTint="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:stateListAnimator="@animator/button_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_usb"
            app:tint="#2D3436"
            android:layout_gravity="center_vertical"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10. USB 終端機 (進階除錯)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2D3436"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="此功能提供一個強大的除錯工具，可直接與樹莓派的作業系統互動。\n\n如何連接：\n1. 使用 USB 線連接您的手機與樹莓派。\n2. 在手機的系統設定中，找到『網路與網際網路』或類似選項。\n3. 啟用『USB 網路共享』(或稱 USB Tethering)。此功能僅分享連線能力，您的手機不需有網際網路連線。\n4. 回到本 App 的『設定』頁面，點擊『USB 終端機』，App 將自動掃描並建立連線。\n\n功能與注意事項：\n• 主畫面會即時顯示樹莓派主程式的所有日誌輸出。\n• 您可透過下方的命令列輸入 Linux 指令 (如 ls, dmesg) 來檢查系統狀態。\n• 『配對藍牙』按鈕可在此模式下為樹莓派與您的手機進行配對，解決藍牙無法正常配對的問題。\n• 警告：請謹慎使用關機、重啟藍牙等系統指令，不當操作可能導致程式或系統不穩定。"
                android:textSize="16sp"
                android:textColor="#636e72"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>